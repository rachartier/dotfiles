{
  "renderMarkdown": true,
  "screenReader": false,
  "theme": "default",
  "enabledPlugins": {
    "context-engineering@awesome-copilot": true,
    "awesome-copilot@awesome-copilot": true,
    "ponytail@ponytail": true,
    "caveman@caveman": true
  },
  "showReasoning": true,
  "footer": {
    "showModelEffort": true,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAgent": true,
    "showCodeChanges": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "experimental": true,
  "effortLevel": "high",
  "includeCoAuthoredBy": false,
  "autoUpdate": true,
  "showTimestamps": true,
  "terminalProgress": true,
  "dynamicRetrieval": {
    "skills": true
  }
}
