{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "disabled": false,
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail@4.12.0",
    "opencode-copilot-statusline@1.2.0"
  ]
}
