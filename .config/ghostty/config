theme=catppuccin-macchiato.conf
# theme=rose-pine
# theme=custom-latte-catppuccin

shell-integration = zsh

cursor-text = "#000000"

font-family = ""
# font-family = MonoLisa
font-family = Berkeley Mono
# font-family = MapleMono
font-family = Symbols Nerd Font Mono
font-family = Noto Sans Symbols
# font-family = CommitMono
# font-family = IBMPlexMono
# font-style = Regular
font-size = 14

font-feature = +zero, +calt, +liga, +clig, +ss01, +ss02

custom-shader = shaders/aurora_glow.glsl
custom-shader = shaders/cursor_tail.glsl
custom-shader-animation = always

gtk-wide-tabs = false
shell-integration-features = true
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

window-decoration = server
window-theme = ghostty


adjust-underline-thickness = -20%
adjust-underline-position = -0
adjust-strikethrough-thickness = -20%
adjust-box-thickness = -20%
adjust-font-baseline = 20%

link-url = true
focus-follows-mouse = true

app-notifications = no-clipboard-copy

# term=xterm-ghostty

window-width = 90
window-height = 30
window-padding-color = background
window-padding-balance = true
window-padding-x = 8
window-padding-y = 8,0
